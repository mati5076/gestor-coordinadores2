# Copia este archivo a .env y completa los valores. (Los secretos reales NO se suben a git.)
DATABASE_URL=""
DIRECT_URL=""
AUTH_SECRET=""            # openssl rand -hex 32

# Correo saliente (alertas de riesgo, enlaces de contraseña)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Opcionales
APP_URL=""                # p. ej. https://tu-app.vercel.app — base de los enlaces de contraseña (si falta, se deduce de la petición)
CRON_SECRET=""            # para /api/cron/alertas-correo
ADMIN_PASSWORD=""         # usada por `npm run db:admin` / `npm run db:seed`
