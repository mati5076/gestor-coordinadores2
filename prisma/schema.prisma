// Base de datos: SQLite por defecto (un solo archivo, cero configuración).
// Para producción multiusuario real, cambia el provider a "postgresql"
// y DATABASE_URL a tu instancia (ej. Supabase, Neon, RDS) — el resto del
// código no cambia.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  // Intentos fallidos de contraseña seguidos. Al llegar a 3 se ofrece el cambio
  // de contraseña (por enlace al correo). Se reinicia al entrar bien o al cambiarla.
  failedAttempts Int @default(0)

  // Enlace de cambio de contraseña: solo se guarda el hash (SHA-256) del token.
  resetTokenHash String?
  resetTokenExp  DateTime?

  // Cuenta habilitada para usar la página. El administrador puede deshabilitarla
  // (no puede iniciar sesión ni recibir correos) y volver a habilitarla.
  habilitado Boolean @default(true)

  // Último correo-resumen de alumnos en riesgo enviado a este usuario al ingresar.
  lastRiskEmailAt DateTime?
}

model Student {
  id                   String   @id @default(cuid())
  nombre               String
  matricula            String   @unique
  carrera              String
  seccion              String?
  email                String?
  telefono             String?
  asistencia           Float    @default(100) // porcentaje de asistencia, 0–100
  // Tipo de materia: define con cuánta asistencia se aprueba (ver MODALIDADES en lib/logic.ts).
  // electiva (50 %) | practica (60 %) | semipresencial (70 %) | online (sin asistencia) | otra (mínimo a mano) | null (sin definir)
  modalidad            String?
  asistenciaMinima     Float?   // % mínimo para aprobar la materia; null en online / sin definir
  rendimiento          String   @default("medio") // alto | medio | bajo
  evaluacionesPerdidas Int      @default(0)
  riesgoManual         String?  // verde | amarillo | rojo | null (automático)
  abandono             Boolean  @default(false)
  createdAt            DateTime @default(now())

  atenciones   Atencion[]
  derivaciones Derivacion[]
}

model Atencion {
  id                          String    @id @default(cuid())
  studentId                   String
  student                     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fecha                       DateTime
  responsable                 String
  tipo                        String    // Académica | Financiera | Personal | Psicosocial | Otra
  tema                        String
  duracionMin                 Int
  observaciones               String?
  acuerdos                    String?
  estado                      String    @default("abierto") // abierto | seguimiento | cerrado
  resueltoPrimerContacto      Boolean   @default(false)
  fechaSeguimientoComprometido DateTime?
  seguimientoCumplido         Boolean?
  fechaCierre                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  derivaciones Derivacion[]
}

model Derivacion {
  id                    String    @id @default(cuid())
  studentId             String
  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  atencionId            String?
  atencion              Atencion? @relation(fields: [atencionId], references: [id])
  area                  String    // Apoyo académico | Área psicosocial | Financiamiento / Aranceles | Otra
  fecha                 DateTime
  estado                String    @default("pendiente") // pendiente | en-gestion | resuelta
  notas                 String?
  fechaResolucion       DateTime?
  seguimientoPosterior  String?
  createdAt             DateTime  @default(now())
}

// Configuración global de la app (una sola fila, id = "global").
// Controla si las alertas de riesgo también se envían por correo al coordinador.
model AlertSettings {
  id               String   @id @default("global")
  emailEnabled     Boolean  @default(false)
  coordinatorEmail String?
  updatedAt        DateTime @updatedAt
}

// Registro de a quién ya se le avisó por correo, para no repetir el mismo
// aviso en cada recarga. Se borra la fila cuando el estudiante deja de estar
// en riesgo (así, si vuelve a caer en riesgo, se avisa de nuevo).
model AlertEmailLog {
  studentId String   @id
  nivel     String   // amarillo | rojo
  sentAt    DateTime @default(now())
}
